{
  "name": "signalk-forecast-verify",
  "version": "0.1.2",
  "description": "Signal K web app comparing measured WMO wind and gust with forecasts from many weather models (ECMWF, NOAA GFS, ICON, AROME, UKMO and more)",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build",
    "mock": "node test-support/mock-server.js"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-weather",
    "wind",
    "forecast",
    "verification",
    "wmo"
  ],
  "author": "Piotr <piotr.pingo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiotrSol/signalk-forecast-verify.git"
  },
  "bugs": {
    "url": "https://github.com/PiotrSol/signalk-forecast-verify/issues"
  },
  "homepage": "https://github.com/PiotrSol/signalk-forecast-verify#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chart.js": "4.5.1"
  },
  "files": [
    "index.js",
    "lib/",
    "public/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "app-icon.svg",
    "screenshots"
  ],
  "signalk": {
    "displayName": "Wind Forecast Check",
    "appIcon": "./app-icon.svg",
    "screenshots": [
      "./screenshots/forecast-charts.png",
      "./screenshots/model-ranking.png"
    ]
  }
}
